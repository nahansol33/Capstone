@model Capstone.Models.ViewModels.ProjectCreateViewModel

@{
    ViewData["Title"] = "Edit Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Project</h1>

<h4>Project</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden field for ProjectId -->
            <input type="hidden" name="ProjectId" value="@ViewData["ProjectId"]" />

            <div class="form-group">
                <label asp-for="ProjectName" class="control-label"></label>
                <input asp-for="ProjectName" class="form-control" />
                <span asp-validation-for="ProjectName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Assign Employees</label>
                <select asp-for="SelectedEmployeeIds" asp-items="Model.AvailableEmployees" class="form-control" multiple="multiple">
                </select>
                <span asp-validation-for="SelectedEmployeeIds" class="text-danger"></span>
            </div>

            <h4>Assigned Employees</h4>
            <ul>
                @foreach (var employeeId in Model.SelectedEmployeeIds)
                {
                    var employee = Model.AvailableEmployees.FirstOrDefault(e => e.Value == employeeId.ToString());
                    if (employee != null)
                    {
                        <li>@employee.Text</li>  
                    }
                }
            </ul>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
