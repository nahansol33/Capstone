@model Capstone.Models.Project

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Project</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProjectName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProjectName)
        </dd>
    </dl>
</div>

<div>
    <h4>Assigned Employees</h4>
    @if (Model.AssignedEmployees != null && Model.AssignedEmployees.Any())
    {
        <ul>
            @foreach (var employee in Model.AssignedEmployees)
            {
                <li>@employee.Name</li> 
            }
        </ul>
    }
    else
    {
        <p>No employees assigned to this project yet.</p>
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ProjectId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
